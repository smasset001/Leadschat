rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'smasset001@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public user profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'free' || isAdmin()
      );
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role || isAdmin()
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Isolated Private User Information (PII, balances, subscription)
    match /userPrivate/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'leadBalance', 'approvedEntitlement', 'leadsDelivered', 'subscriptionStatus'
        ])
      );
      allow delete: if isAdmin();
    }

    // Unique phone registry
    match /phoneRegistry/{phoneHash} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Conversations
    match /conversations/{convId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participantIds || isAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
        ) && (
          request.resource.data.senderId == request.auth.uid
        ) && (
          request.resource.data.text is string && request.resource.data.text.size() <= 4000
        );
        allow update, delete: if isAdmin();
      }
    }

    // Chat Links (Public resolution for guests, owner write)
    match /chatLinks/{linkId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Analytics Link Events
    match /linkEvents/{eventId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Admin-Controlled Reels
    match /reels/{reelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Webinars
    match /webinars/{webinarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lead Packages
    match /leadPackages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lead Purchase Requests
    match /leadPurchaseRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        request.resource.data.affiliateId == request.auth.uid &&
        request.resource.data.status == 'pending'
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Lead Inventory (Raw Pool)
    match /leadInventory/{leadId} {
      allow read, write: if isAdmin();
    }

    // Lead Assignments (Affiliate CRM)
    match /leadAssignments/{assignmentId} {
      allow read: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        (
          resource.data.affiliateId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'affiliateId', 'leadInventoryId', 'name', 'phone'
          ])
        ) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Lead Ledger (Audit & balances)
    match /leadLedger/{ledgerId} {
      allow read: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Broadcasts (Pro only)
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.affiliateId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
    }

    // In-App Notifications
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Admin Audit Logs (strictly append-only, never update/delete)
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Application Settings
    match /applicationSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
